# =============================================================================
# Mira — environment variables
# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
#
# Mira itself reads no environment variable: an app passes its pools to
# createMira(). These are read only by fromEnv() (when an app calls it), the
# `mira` CLI, this repository's tests and the simulation (MIRA_SIM_*).
# =============================================================================

# -----------------------------------------------------------------------------
# The appDb pool: fromEnv() with its default prefix MIRA_DB
# -----------------------------------------------------------------------------
MIRA_DB_USER=your_schema_user
MIRA_DB_PASSWORD=change-me
# Easy Connect (host:port/service_name), a TNS descriptor, or a tnsnames alias.
# Or leave it blank and set MIRA_DB_HOST + MIRA_DB_SERVICE (+ MIRA_DB_PORT, default 1521).
MIRA_DB_CONNECT_STRING=localhost:1521/ORCLPDB1
MIRA_DB_HOST=
MIRA_DB_PORT=
MIRA_DB_SERVICE=

# Pool sizing, whole numbers; blank = Mira's pool defaults (min 10, max 50,
# queue 40, idle timeout 30 s). Oracle holds a server process per poolMin
# connection even when idle, so keep poolMin small; size poolMax by concurrent
# operations (each withConnection call borrows one connection).
#   MIRA_DB_POOL_MIN, MIRA_DB_POOL_MAX, MIRA_DB_POOL_INCREMENT
#   MIRA_DB_QUEUE_MAX        acquire-queue depth; past it a request fails at once (NJS-076)
#   MIRA_DB_QUEUE_TIMEOUT    ms a request waits in the queue (NJS-040); 0 = forever
#   MIRA_DB_POOL_TIMEOUT     s an idle connection above poolMin survives; 0 = never closed
#   MIRA_DB_CONNECT_TIMEOUT  ms to open one connection (Thin mode)
#   MIRA_DB_POOL_PING_INTERVAL, MIRA_DB_STMT_CACHE_SIZE
MIRA_DB_POOL_MIN=2
MIRA_DB_POOL_MAX=10
MIRA_DB_QUEUE_MAX=40
MIRA_DB_POOL_TIMEOUT=30

# More pools: fromEnv({ pools: { appDb: "MIRA_DB", reporting: "MIRA_RPT" }, defaultPool: "appDb" })
# reads MIRA_RPT_USER, MIRA_RPT_PASSWORD, MIRA_RPT_CONNECT_STRING … the same way.

# -----------------------------------------------------------------------------
# Driver (fromEnv): auto (default) | thin | thick, and the Instant Client directory
# -----------------------------------------------------------------------------
# auto tries Thick mode (MIRA_DRIVER_LIB_DIR, else the system library path) and
# falls back to Thin. thick fails instead of falling back.
MIRA_DRIVER_MODE=
MIRA_DRIVER_LIB_DIR=

# -----------------------------------------------------------------------------
# Simulation schema (bun run sim) - optional
# -----------------------------------------------------------------------------
# A schema owned by the simulation alone (create it with sim/setup-schema.sql).
# Every run drops and rebuilds its SIM_* objects there; the simulation refuses
# to start if this is the test schema (MIRA_DB_USER). Connection:
# MIRA_SIM_DB_CONNECT_STRING, else a TNS descriptor from MIRA_SIM_DB_HOST /
# _PORT / _SID, else the MIRA_DB_* connection above. MIRA_SIM_GRANTEE is the
# schema the DCL checks grant to (default MIRA_DB_USER).
MIRA_SIM_DB_USERNAME=
MIRA_SIM_DB_PASSWORD=
MIRA_SIM_DB_CONNECT_STRING=
MIRA_SIM_DB_HOST=
MIRA_SIM_DB_PORT=
MIRA_SIM_DB_SID=
MIRA_SIM_GRANTEE=

# -----------------------------------------------------------------------------
# Tests and simulation
# -----------------------------------------------------------------------------
# MIRA_LOGS=1 shows every Mira log line on the console (default: silent).
# MIRA_SKIP_PERSIST=1 skips writing run history to MIRA_TEST_RESULTS / _METRICS.
