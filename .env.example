# =============================================================================
# Mira — environment variables
# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
# Every variable below is read by src/ or by test/oracle-mongo-wrapper/test.js.
# =============================================================================

# NODE_ENV - "production" turns console logging off unless ENABLE_CONSOLE_LOGS=true
# or DOCKER_CONTAINER=true; any other value keeps console logging on.
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (Oracle)
# -----------------------------------------------------------------------------
# DB_TYPE - adapter name. Only "oracle" ships. Code default oracle.
DB_TYPE=oracle
DB_HOST=localhost
DB_PORT=1521
# DB_APP_SERVICE_NAME - despite the name, this value is used as the Oracle SID:
# the connect string is built as (CONNECT_DATA=(SID=<value>)). A PDB service
# name (e.g. XEPDB1) is NOT a SID and will be refused by the listener unless the
# listener maps it. Typical SIDs: XE, ORCL. The key name is kept for
# compatibility with existing deployments.
DB_APP_SERVICE_NAME=orclpdb1

# Credentials shared by the appDb and appDbBulk pools.
APP_DB_USERNAME=your_schema_user
APP_DB_PASSWORD=change-me

# ORACLE_INSTANT_CLIENT - Instant Client directory; enables Thick mode.
# Blank = Thin mode (no Instant Client needed).
ORACLE_INSTANT_CLIENT=


# -----------------------------------------------------------------------------
# Oracle pool sizing (appDb - interactive traffic)
# -----------------------------------------------------------------------------
# Oracle holds a server process per poolMin connection even when idle, so do
# not over-provision poolMin. Size poolMax by concurrent operations, not by
# user count: every withConnection call borrows its own connection.
#   APP_POOL_MIN     - connections opened at startup. Code default 5; recommended 2.
#                      0 is treated as unset (falls back to 5).
#   APP_POOL_MAX     - hard ceiling; requests queue past it. Code default 20;
#                      recommended 10.
#   APP_QUEUE_MAX    - acquire-queue depth; past it the request is shed
#                      (NJS-076). Code default 40.
#   APP_POOL_TIMEOUT - SECONDS an idle connection above poolMin survives.
#                      0 = never close. Code default 30.
APP_POOL_MIN=2
APP_POOL_MAX=10
APP_QUEUE_MAX=40
APP_POOL_TIMEOUT=30


# -----------------------------------------------------------------------------
# Oracle pool sizing (appDbBulk - long-hold work)
# -----------------------------------------------------------------------------
# Second pool on the SAME credentials for long-held work (exports, backups, bulk
# loads) so it never starves interactive traffic. Values shown are the
# code defaults.
#   APP_BULK_POOL_MIN        - code default 1.
#   APP_BULK_POOL_MAX        - code default 6.
#   APP_BULK_QUEUE_MAX       - code default 24.
#   APP_BULK_QUEUE_TIMEOUT   - ms an acquire may wait in the queue (NJS-040).
#                              Code default 30000.
#   APP_BULK_CONNECT_TIMEOUT - ms for the acquire race; the driver receives
#                              ceil(ms/1000) s (Thin mode only). Code default 20000.
APP_BULK_POOL_MIN=1
APP_BULK_POOL_MAX=6
APP_BULK_QUEUE_MAX=24
APP_BULK_QUEUE_TIMEOUT=30000
APP_BULK_CONNECT_TIMEOUT=20000

# -----------------------------------------------------------------------------
# Logging (src/utils/logger.ts)
# -----------------------------------------------------------------------------
# LOG_LEVEL - EMERG | ALERT | CRITICAL | ERROR | WARNING (alias WARN) | NOTICE |
# INFO | DEBUG. Code default INFO.
LOG_LEVEL=INFO
# ENABLE_CONSOLE_LOGS - false always disables console output. Otherwise console
# output is on when true, when NODE_ENV is not production, or when
# DOCKER_CONTAINER=true.
ENABLE_CONSOLE_LOGS=true
# DOCKER_CONTAINER - true when running in a container (console logs on in production).
DOCKER_CONTAINER=false
# LOG_EXCLUDE_HEALTH - true = health-check requests are not logged. Code default false.
LOG_EXCLUDE_HEALTH=false
# LOG_EXCLUDE_URLS - comma-separated URL prefixes not logged.
LOG_EXCLUDE_URLS=
# LOG_MAX_SAFESTR_LENGTH - truncate the JSON form of logged OBJECTS to N
# characters. Plain string messages are never truncated. Blank = no truncation.
LOG_MAX_SAFESTR_LENGTH=
# LOG_CALLSITE - capture function/file/line in each entry. Code default true.
LOG_CALLSITE=true
# LOG_MAX_QUEUE_LENGTH - cap on queued-but-unwritten log entries; on overflow the
# OLDEST entries are dropped and the loss is reported. Code default 10000.
LOG_MAX_QUEUE_LENGTH=10000
# DATA_SIGNING_SECRET - keys the log redaction tokens (same identifier → same
# token, so incidents stay correlatable). Use 32+ random characters; blank falls
# back to an unkeyed development key.
DATA_SIGNING_SECRET=
